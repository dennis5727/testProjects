# Copy to src/fastapi_blog/.env; use a long random secret.
SECRET_KEY=replace-with-a-long-random-secret
# Omit DATABASE_URL to keep the existing SQLite database.
# DATABASE_URL=postgresql+psycopg://bloguser:blogpass@localhost/blog
ACCESS_TOKEN_EXPIRE_MINUTES=30
POSTS_PER_PAGE=10
RESET_TOKEN_EXPIRE_MINUTES=60
FRONTEND_URL=http://localhost:8000

# Configure an SMTP service to deliver reset emails.
MAIL_SERVER=localhost
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@example.com
MAIL_USE_TLS=true
